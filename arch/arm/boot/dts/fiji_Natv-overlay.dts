/dts-v1/;
/plugin/;
#include <dt-bindings/gpio/gpio.h>

/ {
	fragment {
		target-path = "/";
		__overlay__ {
			fingerprint@0 {
				compatible = "microarray,afs121";
				//fpint-gpios = <&ap_gpio 130 0>;
			};

			flash-gpios {
				compatible = "sprd,flash-sgm37891";
				flash-ic = <37891>;
				flash-1w-gpios = <&ap_gpio 62 0>;
				flash-torch-en-gpios = <&ap_gpio 63 0>;
				flash-en-gpios = <&ap_gpio 72 0>;
			};
/*			pwm_backlight: sprd_backlight {
				compatible = "pwm-backlight";
				pwms = <&pwms 1 30000>;
				pwm-names = "backlight";
